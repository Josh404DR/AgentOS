# Stable cross-machine line endings. Explicit rules override core.autocrlf.
* text=auto eol=lf

*.ps1 text eol=lf
*.psm1 text eol=lf
*.psd1 text eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf

